# Copy to .env, replace every blank sensitive value, then keep .env outside version control.
ERP_IMAGE_REGISTRY=registry.example.com/erp
ERP_VERSION=1.0.0
ERP_HTTP_PORT=8080
TZ=Asia/Shanghai

# Dedicated instance binding. The domain must already be verified in the SaaS control plane.
ERP_SAAS_BOUND_TENANT_ID=customer001
ERP_SAAS_BOUND_HOST=erp.customer.example
ERP_SAAS_CONTROL_BASE_URL=https://saas-control.example.com
ERP_SAAS_DOMAIN_CACHE_TTL_MS=86400000

# Generate independent high-entropy values. Never reuse them between environments.
ERP_INTERNAL_AUTH_SIGNATURE_SECRET=
ERP_SAAS_TENANT_ASSERTION_SIGNATURE_SECRET=
ERP_JWT_SECRET=
ERP_SAAS_SNAPSHOT_VERIFICATION_KEY_ID=primary-2026
ERP_SAAS_SNAPSHOT_VERIFICATION_SECRET=

# Use mysql, redis and nacos hostnames only with the bundled-infra profile.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=erp_customer001
MYSQL_USERNAME=erp_customer001
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
NACOS_SERVER_ADDR=nacos:8848
NACOS_DISCOVERY_ENABLED=true
NACOS_CONFIG_ENABLED=true

ERP_AI_ENABLED=true
ERP_AI_PROVIDER_BASE_URL=https://ai-provider.example.com/v1
ERP_AI_MODEL=gpt-5.1

# Optional object storage. Prefer workload identity or an external secret injector in production.
HR_STORAGE_S3_ENABLED=false
HR_STORAGE_S3_ENDPOINT=
HR_STORAGE_S3_REGION=us-east-1
HR_STORAGE_S3_ACCESS_KEY=
HR_STORAGE_S3_SECRET_KEY=
HR_STORAGE_S3_BUCKET=

ERP_SQL_UPGRADE_ENABLED=true
ERP_LOG_ROOT_LEVEL=INFO
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
